#define APR_EN_UI_ANN_ARM_FAILED         "Some sources could not be started. The recording continues without them."
#define APR_EN_UI_ANN_SOURCE_DIED        "%1!s! has exited. It records silence from here on."
#define APR_EN_UI_ANN_SOURCE_MUTED       "%1!s! is muted in the Windows volume mixer, so it records silence."
#define APR_EN_UI_ANN_ACTION_FAILED      "%1!s! stopped saving: %2!s! The file that exists is still playable."
#define APR_EN_UI_ANN_ALREADY_RECORDING  "A recording is already running."
#define APR_EN_UI_ANN_NOT_RECORDING      "Nothing is being recorded."
#define APR_EN_UI_ANN_NOTHING_TO_RECORD  "There is nothing to record yet. Add a source, a bus and an output first."
#define APR_EN_UI_ANN_BUSY_RECORDING     "That cannot be changed while a recording is running. Stop the recording first."
#define APR_EN_UI_HEALTH_OK              "%1!s! is recording."
#define APR_EN_UI_HEALTH_MUTED           "%1!s! is muted and is recording silence."
#define APR_EN_UI_HEALTH_DEAD            "%1!s! has exited and is recording silence."
#define APR_EN_UI_PANE_RECORDING         "Recording status"
#define APR_EN_UI_DESC_RECORDING         "Says whether a recording is running, how long it has been going, and how each source is doing."
#define APR_EN_UI_CLOSE_TITLE            "A recording is still running"
#define APR_EN_UI_CLOSE_BODY             "apprecorder is still recording. Closing now stops the recording and closes every file so that it stays playable."
#define APR_EN_UI_CLOSE_STOP_AND_EXIT    "Stop recording and close"
#define APR_EN_UI_CLOSE_KEEP_RECORDING   "Keep recording"
#define APR_EN_UI_CLOSE_TO_TRAY          "Leave it recording in the notification area"
#define APR_EN_UI_ANN_CLOSING_FILES      "Closing the files. This window will close when they are safely written."
#define APR_EN_UI_ANN_OUTPUT_RENAMED     "That name is already a recording, so this take is being saved as %1!s! instead. Nothing was overwritten."
/* NOT the same sentence as "the files are being written". Saying that one
 * twice told the user the close was still in progress at the exact moment it
 * had given up. */
#define APR_EN_UI_ANN_CLOSE_TIMEOUT      "The files are taking longer than expected to close, so the window has stayed open. Try closing it again."
#define APR_EN_UI_ANN_NO_TRAY            "There is no notification area icon, so hiding the window would leave nothing to reach it by. The window has stayed open."
/* Both halves of a source going away and coming back. The recovery is the
 * one that says the take is intact, so it is never left to a colour or an
 * icon: it is a sentence, on whichever channel can reach the user. */
#define APR_EN_UI_ANN_SOURCE_RECOVERED   "%1!s! is back and is being recorded again. The time it was away is silence in the file."
#define APR_EN_UI_ANN_EXCLUSION_HELD     "%1!s! has stopped recording, because the application it holds back has exited. Carrying on would record that application the moment it starts again."

