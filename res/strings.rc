#define APR_EN_UI_ANN_REMOVED                   "%1!s! removed."
#define APR_EN_UI_ANN_REMOVE_REFUSED            "A file is removed together with the bus that saves it, not on its own."
#define APR_EN_UI_ANN_GAIN                      "%1!s!, %2!s! decibels."
#define APR_EN_UI_ANN_GAIN_NO_EDGE              "%1!s! feeds no bus yet, so there is no level to set."
#define APR_EN_UI_ANN_NO_EDGE_DOWN              "%1!s! feeds nothing yet."
#define APR_EN_UI_ANN_NO_EDGE_UP                "Nothing feeds %1!s! yet."
#define APR_EN_UI_ANN_CANVAS_EMPTY              "The signal flow is empty. Press Control and 1 to add a source."
#define APR_EN_UI_ANN_NOT_YET                   "That is not available yet."
#define APR_EN_UI_ANN_CONNECT_NOT_SOURCE        "A connection starts at a source, and %1!s! is not one."
#define APR_EN_UI_ANN_GAIN_NOT_SOURCE           "Only a source has a level, and %1!s! is not one."
/* The reason, in the frame the catalog owns. Before this, a real refusal from
 * the model -- "the graph is running", "that bus is gone" -- was announced as
 * "That is not available yet", which describes a feature nobody wrote rather
 * than the thing that just happened. */
#define APR_EN_UI_ANN_EDIT_FAILED               "That change was refused: %1!s!"

/* One line per canvas operation, for Help > Keyboard Shortcuts. The binding
 * table in include/ui_canvas.h is both what dispatches the key and what that
 * screen renders, so a shortcut cannot be documented as one key and
 * implemented as another. */

#define APR_EN_UI_KEY_NEXT_NODE                 "Move to the next node"
#define APR_EN_UI_KEY_PREV_NODE                 "Move to the previous node"
#define APR_EN_UI_KEY_NEXT_IN_COLUMN            "Move to the next node in this column"
#define APR_EN_UI_KEY_PREV_IN_COLUMN            "Move to the previous node in this column"
#define APR_EN_UI_KEY_DOWNSTREAM                "Go to what this node feeds"
#define APR_EN_UI_KEY_UPSTREAM                  "Go to what feeds this node"
#define APR_EN_UI_KEY_FIRST                     "Move to the first node"
#define APR_EN_UI_KEY_LAST                      "Move to the last node"
#define APR_EN_UI_KEY_CONNECT                   "Connect this node to another"
#define APR_EN_UI_KEY_DISCONNECT                "Disconnect this node from another"
#define APR_EN_UI_KEY_REMOVE                    "Remove this node"
#define APR_EN_UI_KEY_ADD_SOURCE                "Add a source"
#define APR_EN_UI_KEY_ADD_BUS                   "Add a bus"
#define APR_EN_UI_KEY_ADD_ACTION                "Add an output"
#define APR_EN_UI_KEY_GAIN_UP                   "Make this source louder"
#define APR_EN_UI_KEY_GAIN_DOWN                 "Make this source quieter"
#define APR_EN_UI_KEY_CANCEL                    "Cancel what is half done"
#define APR_EN_UI_KEY_DESCRIBE                  "Say this node and its connections again"

/* The names of keys that are not a printable character. IN THE CATALOG, not in
 * C: the modifiers already were, so a shortcut rendered half in the interface
 * language and half in English is the mixed-language failure rule 6 exists to
 * prevent. A translator who decides the keycap legend is the right word simply
 * writes the English word here -- that is a translation decision, and this is
 * where translation decisions live. */
#define APR_EN_UI_KEYNAME_TAB                   "Tab"
#define APR_EN_UI_KEYNAME_ENTER                 "Enter"
#define APR_EN_UI_KEYNAME_SPACE                 "Space"
#define APR_EN_UI_KEYNAME_DELETE                "Delete"
#define APR_EN_UI_KEYNAME_ESCAPE                "Escape"
#define APR_EN_UI_KEYNAME_HOME                  "Home"
#define APR_EN_UI_KEYNAME_END                   "End"
#define APR_EN_UI_KEYNAME_LEFT                  "Left Arrow"
#define APR_EN_UI_KEYNAME_RIGHT                 "Right Arrow"
#define APR_EN_UI_KEYNAME_UP                    "Up Arrow"
#define APR_EN_UI_KEYNAME_DOWN                  "Down Arrow"
#define APR_EN_UI_KEYNAME_PLUS                  "Plus"
#define APR_EN_UI_KEYNAME_MINUS                 "Minus"
#define APR_EN_UI_KEYNAME_NUM_PLUS              "Numpad Plus"
#define APR_EN_UI_KEYNAME_NUM_MINUS             "Numpad Minus"
#define APR_EN_UI_KEYNAME_PERIOD                "Full Stop"
/* %1 is the function key's number, already rendered by apr_str_number(). */
#define APR_EN_UI_KEYNAME_FUNCTION              "F%1!s!"

/* ---- the structure panel (src/ui/tree_panel.c).
 *
 * A TREEVIEW ITEM'S TEXT IS ITS ACCESSIBLE NAME. There is no second string a
 * screen reader reads instead, so each row below is a whole sentence: what
 * the node is, what kind it is, what it is wired to, and any state that
 * changes what the file will actually contain. "Teams" is a label; "Teams,
 * application, muted in Windows so it records silence, feeding Main Mix" is
 * the row that saves a three-hour recording.
 *
 * The bus row counts arrive as already-pluralised phrases (N_SOURCES,
 * N_OUTPUTS) in their own inserts, so a translator controls agreement; the
 * state clauses arrive the same way, in one insert each, so a translator can
 * move a state clause to wherever Arabic wants it rather than finding it
 * welded to the end by C. */

#define APR_EN_UI_TREE_NAME                     "Recording graph"
#define APR_EN_UI_TREE_DESC                     "Every bus in this session, the sources feeding it and the files it saves. Up Arrow and Down Arrow move through the graph, Left Arrow and Right Arrow collapse and expand a bus, and typing the first letters of a name jumps to it."
#define APR_EN_UI_TREE_EMPTY                    "This session has no buses yet. Use Add Bus on the Edit menu to make one."
#define APR_EN_UI_TREE_UNASSIGNED_GROUP         "Sources not connected to any bus"
#define APR_EN_UI_TREE_BUS                      "%1!s!, bus, mixing %2!s! to %3!s!"
#define APR_EN_UI_TREE_BUS_RECORDING            "%1!s!, bus, recording now, mixing %2!s! to %3!s!"
#define APR_EN_UI_TREE_SOURCE                   "%1!s!, %2!s!, feeding %3!s!"
#define APR_EN_UI_TREE_SOURCE_SHARED            "%1!s!, %2!s!, feeding %3!s! and %4!s!"
#define APR_EN_UI_TREE_SOURCE_STATE             "%1!s!, %2!s!, %3!s!, feeding %4!s!"
#define APR_EN_UI_TREE_SOURCE_STATE_SHARED      "%1!s!, %2!s!, %3!s!, feeding %4!s! and %5!s!"
#define APR_EN_UI_TREE_SOURCE_UNUSED            "%1!s!, %2!s!, connected to no bus, so nothing records it"
#define APR_EN_UI_TREE_SOURCE_UNUSED_STATE      "%1!s!, %2!s!, %3!s!, and connected to no bus, so nothing records it"
#define APR_EN_UI_TREE_STATE_MUTED              "muted in Windows, so it records silence"
#define APR_EN_UI_TREE_STATE_EXITED             "closed, so it records silence from here on"
#define APR_EN_UI_TREE_ACTION                   "%1!s!, written from %2!s!"
#define APR_EN_UI_TREE_ACTION_FAILED            "%1!s!, written from %2!s!, stopped after an error"

/* ---- session files (src/session/, and the --session option).
 *
 * WHY THE RESOLUTION MESSAGES CARRY TWO NAMES EACH. A session file records
 * what to capture; process ids do not survive a reboot, so opening one is a
 * search rather than a lookup, and it can succeed in ways that are not what
 * the file asked for. "Teams was not found" leaves the reader nothing to do.
 * Naming both what was recorded and what is there now lets them decide
 * whether the substitution is the same program -- so every entry below that
 * describes a substitution has an insert for each half.
 *
 * The system-capture entry is deliberately NOT the same sentence as
 * WARN_SYSTEM_CAPTURE_SCOPE. That one describes a capture the user just
 * asked for by typing --system-minus-tree. This one describes a capture a
 * FILE asked for, which design 4.1.1 says must never proceed without
 * confirmation, and it has to say what to do about it. */

#define APR_EN_CLI_CMD_SAVE_SESSION             "save-session          Write the recording described on this command line to a session file instead of recording it."
#define APR_EN_CLI_OPT_SESSION                  "--session <path>       The session file: read by record, written by save-session."
#define APR_EN_CLI_OPT_ALLOW_SYSTEM_CAPTURE     "--allow-system-capture Agree to record everything the computer is playing, when a session file asks for it. Never implied."
#define APR_EN_CLI_OPT_ALLOW_MISSING            "--allow-missing        Record without the sources that could not be found, instead of stopping."

#define APR_EN_ERR_SESSION_NOT_FOUND            "There is no session file at %1!s!."
#define APR_EN_ERR_SESSION_UNREADABLE           "%1!s! could not be read: %2!s!"
/* The backslash sentence is not padding. A hand-edited session file on
 * Windows fails here far more often than for any other reason: JSON treats a
 * backslash as an escape, so C:\Users\me is invalid and C:\\Users\\me is what
 * is meant. Files apprecorder writes are always correct; this message is for
 * the ones a person edited. */
#define APR_EN_ERR_SESSION_NOT_JSON             "%1!s! is not a session file: the text is not JSON. If you edited it by hand, check that every backslash in a Windows path is doubled, or use forward slashes instead."
#define APR_EN_ERR_SESSION_TRUNCATED            "%1!s! stops part way through. It was probably not finished being written."
#define APR_EN_ERR_SESSION_NOT_A_SESSION        "%1!s! is JSON, but it is not an apprecorder session."
#define APR_EN_ERR_SESSION_TOO_NEW              "%1!s! was written by a newer version of apprecorder and needs at least version %2!s! of the session format to be read safely. This build reads version %3!s!."
#define APR_EN_ERR_SESSION_TOO_OLD              "%1!s! uses session format version %2!s!, which this build no longer reads."
#define APR_EN_ERR_SESSION_BAD_FIELD            "%1!s! cannot be used: %2!s! is not the kind of value that belongs there."
#define APR_EN_ERR_SESSION_BAD_VALUE            "%1!s! cannot be used: %2!s! is outside the range apprecorder can work with."
#define APR_EN_ERR_SESSION_TOO_MANY             "%1!s! describes more than apprecorder can hold, at %2!s!."
#define APR_EN_ERR_SESSION_DANGLING_REF         "%1!s! cannot be used: %2!s! names a source the file does not describe."
#define APR_EN_ERR_SESSION_WITH_SOURCES         "--session describes the whole recording, so %1!s! cannot be given as well. Edit the session file, or leave --session out."
#define APR_EN_ERR_SESSION_NEEDED               "save-session needs --session <path> to say where to write."
#define APR_EN_ERR_SESSION_NOT_WRITTEN          "%1!s! could not be written: %2!s!"

#define APR_EN_WARN_SESSION_FROM_NEWER          "%1!s! was written by a newer version of apprecorder. Anything it asks for that this build does not know about is being ignored."
#define APR_EN_WARN_SESSION_UNKNOWN_KEYS        "%1!s! contains settings this build does not know, starting with %2!s!. They are being ignored."

#define APR_EN_ERR_SESSION_SOURCE_MISSING       "%1!s! is not running. The session recorded it at %2!s!."
#define APR_EN_ERR_SESSION_DEVICE_MISSING       "%1!s! is not connected, so it cannot be recorded."
#define APR_EN_ERR_SESSION_AMBIGUOUS            "There is more than one %1!s! and nothing in the session says which one to record."
#define APR_EN_ERR_SESSION_AMBIGUOUS_PIDS       "Choose one with --pid: %1!s!"
/* Design 4.1.1: this must say what is really being captured -- a whole
 * process tree is held back, and everything else on the machine is recorded
 * -- and it must say what the user has to do to agree to that. */
#define APR_EN_ERR_SESSION_NEEDS_CONSENT        "%1!s! asks to record everything this computer plays, holding back only %2!s! and whatever it has started. apprecorder will not do that because a file asked for it. Add --allow-system-capture if that is what you want."

#define APR_EN_WARN_SESSION_MOVED               "%1!s! is now running from %2!s!, not %3!s! where the session recorded it. Recording the copy that is running."
#define APR_EN_WARN_SESSION_BY_WINDOW_CLASS     "There is more than one %1!s!. Recording process %2!s!, because its window matches the one the session recorded."
#define APR_EN_WARN_SESSION_FIRST_OF_MANY       "There is more than one %1!s! and nothing tells them apart. Recording process %2!s!."
#define APR_EN_WARN_SESSION_DEVICE_BY_NAME      "%1!s! is connected but Windows now identifies it differently. Recording it anyway."
#define APR_EN_WARN_SESSION_DROPPED             "Recording without %1!s!, which could not be found."

#define APR_EN_STATUS_SESSION_LOADED            "Loaded %1!s!."
#define APR_EN_STATUS_SESSION_SAVED             "Saved %1!s!."
#define APR_EN_ERR_SESSION_NOT_USABLE           "%1!s! cannot be turned into a recording on this machine. The first source it cannot use is %2!s!."

#define APR_EN_N_OTHER_BUSES_ZERO               "%1!s! other buses"
#define APR_EN_N_OTHER_BUSES_ONE                "%1!s! other bus"
#define APR_EN_N_OTHER_BUSES_TWO                "%1!s! other buses"
#define APR_EN_N_OTHER_BUSES_FEW                "%1!s! other buses"
#define APR_EN_N_OTHER_BUSES_MANY               "%1!s! other buses"
#define APR_EN_N_OTHER_BUSES_OTHER              "%1!s! other buses"

#define APR_EN_N_OUTPUTS_ZERO                   "%1!s! outputs"
#define APR_EN_N_OUTPUTS_ONE                    "%1!s! output"
#define APR_EN_N_OUTPUTS_TWO                    "%1!s! outputs"
#define APR_EN_N_OUTPUTS_FEW                    "%1!s! outputs"
#define APR_EN_N_OUTPUTS_MANY                   "%1!s! outputs"
#define APR_EN_N_OUTPUTS_OTHER                  "%1!s! outputs"


/* ---- recording, live ---- */
#define APR_EN_UI_STATUS_IDLE            "Not recording."
#define APR_EN_UI_STATUS_RECORDING       "Recording. %1!s! elapsed."
#define APR_EN_UI_STATUS_FINISHING       "Finishing the recording and closing the files."
#define APR_EN_UI_TIME_ELAPSED           "%1!s!:%2!s!:%3!s!"
#define APR_EN_UI_ANN_RECORD_STARTED     "Recording started."
