#define APR_AR_ENTRY(name, id)      APR_AR_##name(id)
#define APR_AR_PENTRY(name, base)   APR_AR_P_##name(base)

LANGUAGE LANG_ARABIC, SUBLANG_ARABIC_SAUDI_ARABIA

/* ONE table, unlike English above, and the reason is mechanical rather than a
 * matter of taste: rc.exe rejects a STRINGTABLE that expands to no entries at
 * all, and every Arabic group except the first is entirely untranslated today,
 * so a per-group split produces four empty tables and a build failure.
 *
 * The English split exists because a single table holding every English string
 * is too large for rc.exe (see strings.h). Arabic will reach that same size the
 * moment it is actually translated, and the fix then is to split this section
 * exactly the way the English one is split -- by which point every group has
 * text in it and no table is empty. Until then this stays one table. */

STRINGTABLE
BEGIN
    APR_STR_LIST(APR_AR_ENTRY)
    APR_STR_PLURAL_LIST(APR_AR_PENTRY)
END
