/* The error reasons. One marker, for the same reason APP_NAME carries one:
 * to prove the whole path end to end -- an error raised on a capture pump,
 * travelling as an identity, resolving through the catalog into the block for
 * the language actually in effect -- before any of it is translated.
 *
 * APR_S_ERR_HR_E_DEVICE_INVALIDATED is the one chosen because it is the
 * failure a user is most likely to meet (a headset unplugged mid-recording)
 * and because it is the sentence BUGS.md M11 quotes. tests/test_err.c pins it
 * by exact code points, so the UTF-8 -> UTF-16 path through rc.exe is
 * verified rather than assumed.
 *
 * Everything else is declared untranslated and falls back to English, which
 * is the honest state until the translation pass runs. */

#define APR_AR_ERR_HR_E_NOT_INITIALIZED(id)           /* not translated yet */
#define APR_AR_ERR_HR_E_ALREADY_INITIALIZED(id)       /* not translated yet */
#define APR_AR_ERR_HR_E_WRONG_ENDPOINT_TYPE(id)       /* not translated yet */
#define APR_AR_ERR_HR_E_DEVICE_INVALIDATED(id)        id  "AR-PLACEHOLDER-REASON تجربة"
#define APR_AR_ERR_HR_E_NOT_STOPPED(id)               /* not translated yet */
