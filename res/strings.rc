/*
 * strings.rc -- apprecorder's string catalog.
 *
 * ONE FILE, ONE EXE. Every locale is a LANGUAGE block here and every block is
 * linked into apprecorder.exe. No satellite DLLs: the binary grows only by the
 * string bytes, which is what keeps design section 2's size goal reachable.
 *
 * ---------------------------------------------------------------------------
 * DO NOT ADD AN ENTRY BY HAND.
 *
 * The entries below are GENERATED, per language, from APR_STR_LIST and
 * APR_STR_PLURAL_LIST in include/strings.h. To add a string:
 *
 *   1. add its name and id to one of those two lists in strings.h;
 *   2. add APR_EN_<NAME> here with the English text;
 *   3. add APR_AR_<NAME>(id) here -- either with a translation, or empty with
 *      a comment saying it is not translated yet.
 *
 * Step 2 is not optional: a name with no APR_EN_ macro leaves a bare
 * identifier where rc.exe expects a string literal, and the build fails. That
 * is deliberate. An untranslated PRIMARY-language string must never be able to
 * reach a user as an empty label.
 *
 * Step 3 is also not optional, for the same mechanical reason, and that is the
 * point: a new id cannot be added without every declared language explicitly
 * saying what happens to it.
 *
 * ---------------------------------------------------------------------------
 * WRITING THE TEXT
 *
 *   - Inserts are FormatMessageW syntax:  %1!s!  %2!s!  ...  Never POSIX
 *     %1$s. Every insert in this catalog is !s!; numbers arrive already
 *     rendered by apr_str_number(), so digit shaping stays in one place.
 *   - Inserts may be reordered, repeated, or left out entirely by a
 *     translator. All three are supported (see tests/test_strings.c).
 *   - One entry is one complete sentence or one complete label. Never a
 *     fragment intended to be glued to another in code.
 *   - Plurals occupy six consecutive ids in CLDR order:
 *     zero, one, two, few, many, other. English selects only one/other, but
 *     all six must be non-empty -- an unreachable slot is filled with the
 *     other form, never left blank.
 *
 * ---------------------------------------------------------------------------
 * ENCODING
 *
 *   This file is UTF-8 with NO byte-order mark, and #pragma code_page(65001)
 *   is what makes rc.exe read it that way. Verified, not assumed: without the
 *   pragma rc.exe reads the bytes in the system ANSI code page and every
 *   non-Latin character silently becomes mojibake at resource-compile time,
 *   where nothing downstream can detect it. Keep the pragma above the first
 *   non-ASCII text. If an editor ever adds a BOM that is fine too -- rc.exe
 *   sniffs it -- but do not rely on one being there.
 *
 *   test_strings.c asserts the Arabic marker's exact UTF-16 code points for
 *   precisely this reason: a test comparing wide literals from a .c file that
 *   was itself mis-decoded would agree with the bug.
 */

#include <windows.h>
#include "strings.h"

#pragma code_page(65001)

/* ===========================================================================
 * ENGLISH -- the primary language, and the only one declared complete.
 * ========================================================================= */

#define APR_EN_APP_NAME                  "apprecorder"
#define APR_EN_APP_TAGLINE               "Records audio from applications and hardware inputs."

#define APR_EN_CLI_USAGE_HEADER          "Usage: apprecorder [command] [options]"
#define APR_EN_CLI_OPT_PID               "--pid <id>             Capture the application with this process id. May be repeated."
#define APR_EN_CLI_OPT_DEVICE            "--device <name>        Capture this hardware input, for example the GoXLR Chat Mic."
#define APR_EN_CLI_OPT_OUT               "--out <path>           Write this bus to this file. May be repeated."
#define APR_EN_CLI_OPT_FORMAT            "--format <id>          Write the next --out in this format instead of the one its file extension names."
#define APR_EN_CLI_OPT_LANG              "--lang <tag>           Interface language, for example en-US or ar-SA."

#define APR_EN_STATUS_RECORDING_TO       "Recording to %1!s!."
#define APR_EN_STATUS_STOPPED            "Recording stopped."
#define APR_EN_STATUS_FINISHING          "Finishing %1!s!."

/* Both warnings are facts the capture spike established, not speculation:
 * loopback sits after the session volume, and WASAPI never reports the death
 * of the process being captured. See SESSION-HANDOFF.md. */
#define APR_EN_WARN_SOURCE_MUTED         "%1!s! is muted in the Windows volume mixer, so it will record as silence."
#define APR_EN_WARN_SOURCE_EXITED        "%1!s! has exited, so its recording ends here."

#define APR_EN_ERR_FILE_OPEN             "Could not open %1!s! for writing: %2!s!"
#define APR_EN_ERR_UNKNOWN_FORMAT        "%1!s! is not a format this build can write."
#define APR_EN_ERR_NO_SOURCES            "Nothing to record: add at least one source first."
/* Repeats %2. Kept because it is natural English, and because a repeated
 * insert is a case a translator will reach for and the code must survive. */
#define APR_EN_ERR_SOURCE_ALREADY_ON_BUS "%1!s! is already on %2!s!. Remove it from %2!s! before adding it again."

#define APR_EN_NODE_KIND_SOURCE          "Source"
#define APR_EN_NODE_KIND_BUS             "Bus"
#define APR_EN_NODE_KIND_ACTION          "Action"
#define APR_EN_UIA_SOURCE_FEEDS          "%1!s!, source, feeding %2!s!."
#define APR_EN_UIA_BUS_FEEDS             "%1!s!, bus, feeding %2!s!."

/* One per registered action, named by AprActionVTable::display_name_id. These
 * are what the tree panel reads out for an output row and what the CLI prints
 * when an encoder fails, so they name the FORMAT, not the library: a reader
 * needs to know what the file will be, not that LAME wrote it. The codec is in
 * parentheses where it is not obvious from the name. */
#define APR_EN_ACTION_NAME_WAV           "WAV (float32, uncompressed)"
#define APR_EN_ACTION_NAME_MP3           "MP3 (MPEG-1 Layer III)"
#define APR_EN_ACTION_NAME_OGG           "Ogg Opus"
#define APR_EN_ACTION_NAME_NONE          "No output (discard)"

/* ---------------------------------------------------------------------------
 * CLI surface. Every line the command-line front end prints is one entry here,
 * including each line of the usage text and each exit-code line -- a help
 * screen assembled from fragments in C is exactly what strings.h forbids, and
 * a translator has to be able to rewrite a whole line rather than a column of
 * it.
 *
 * NOT here, deliberately: the field names inside --json output. Those are a
 * wire format that scripts match on, not prose a person reads, and localizing
 * them would break every script the moment the interface language changed.
 * Everything a person reads goes through this catalog; everything a program
 * parses is fixed ASCII.
 * ------------------------------------------------------------------------- */

#define APR_EN_CLI_COMMANDS_HEADER              "Commands"
#define APR_EN_CLI_CMD_RECORD                   "record                 Record. This is what apprecorder does when no command is given."
#define APR_EN_CLI_CMD_LIST_APPS                "list-apps              List the applications that are playing audio right now."
#define APR_EN_CLI_CMD_LIST_DEVICES             "list-devices           List the audio capture devices this computer has."
#define APR_EN_CLI_CMD_HELP                     "help                   Show this help."
#define APR_EN_CLI_CMD_VERSION                  "version                Show which build this is."
#define APR_EN_CLI_SOURCES_HEADER               "Sources. Each one joins the bus opened most recently."
#define APR_EN_CLI_OPT_BUS                      "--bus <name>           Open a bus. The sources and outputs that follow belong to it."
#define APR_EN_CLI_OPT_EXE                      "--exe <name>           Capture the application whose program file is <name>, for example chrome.exe."
#define APR_EN_CLI_OPT_FAKE                     "--fake <hz>[,<ppm>[,<amp>]]   Add a source apprecorder generates itself. Reads no audio hardware and plays nothing."
#define APR_EN_CLI_OPT_GAIN                     "--gain <dB>            Gain for the source named just before it. 0 dB leaves it alone."
#define APR_EN_CLI_OPT_SYSTEM_MINUS_TREE        "--system-minus-tree <id>   Record all system audio and hold back one process tree, named by its process id. Read what it prints before you use it."
#define APR_EN_CLI_OUTPUTS_HEADER               "Outputs. Each one joins the bus opened most recently."
#define APR_EN_CLI_OPT_BITRATE                  "--bitrate <kbps>       Bitrate for the next --out, where the format has one. 0 leaves it to the encoder."
#define APR_EN_CLI_OPT_QUALITY                  "--quality <n>          Quality for the next --out, where the format has one. 0 leaves it to the encoder."
#define APR_EN_CLI_SESSION_HEADER               "The session as a whole."
#define APR_EN_CLI_OPT_RATE                     "--rate <hz>            Sample rate every source and every file uses. 48000 by default."
#define APR_EN_CLI_OPT_CHANNELS                 "--channels <n>         Channel count every source and every file uses. 2 by default."
#define APR_EN_CLI_OPT_DURATION                 "--duration <seconds>   Stop on its own after this long. Without it, recording runs until Ctrl+C."
#define APR_EN_CLI_OPT_DRY_RUN                  "--dry-run              Check the whole command line and print what would happen. Opens no audio device and writes no file."
#define APR_EN_CLI_OPT_JSON                     "--json                 Print JSON for a script to read instead of text for a person."
#define APR_EN_CLI_OPT_QUIET                    "--quiet                Print warnings and errors only."
#define APR_EN_CLI_OPT_ALL                      "--all                  In list-apps, include applications that hold an audio session but are silent at this moment."
#define APR_EN_CLI_OPT_LOG_LEVEL                "--log-level <level>    How much apprecorder logs: trace, debug, info, warn, error or off. warn by default."
#define APR_EN_CLI_OPT_LOG_FILE                 "--log-file <path>      Write the log to this file as well."
#define APR_EN_CLI_EXIT_HEADER                  "Exit codes, for scripts."
#define APR_EN_CLI_EXIT_OK                      "0   Finished. Every file was closed and every file plays."
#define APR_EN_CLI_EXIT_USAGE                   "1   The command line could not be read."
#define APR_EN_CLI_EXIT_CONFIG                  "2   The command line was read, but it does not describe a recording that can be made."
#define APR_EN_CLI_EXIT_NOT_FOUND               "3   A process, application or capture device named on the command line is not there."
#define APR_EN_CLI_EXIT_OUTPUT                  "4   A file could not be created, or could not be closed properly."
#define APR_EN_CLI_EXIT_CAPTURE                 "5   A source could not be opened or could not be started."
#define APR_EN_CLI_EXIT_INCOMPLETE              "6   Recording finished and every file plays, but something went wrong while it ran."
#define APR_EN_CLI_EXIT_INTERNAL                "7   apprecorder failed and has no better description for it than that."
#define APR_EN_CLI_EXAMPLES_HEADER              "Examples"
#define APR_EN_CLI_EXAMPLE_ONE                  "apprecorder --pid 4321 --out teams.mp3"
#define APR_EN_CLI_EXAMPLE_TWO                  "apprecorder --bus Mix --exe teams.exe --device Chat --out mix.wav --bus Voice --device Chat --out voice.wav"
#define APR_EN_CLI_STOP_HINT                    "Press Ctrl+C to stop. Every file is closed and made playable before apprecorder exits."
#define APR_EN_CLI_VERSION_LINE                 "apprecorder %1!s!"
#define APR_EN_ERR_UNKNOWN_COMMAND              "%1!s! is not a command apprecorder has. Run apprecorder help to see the ones it does."
#define APR_EN_ERR_UNKNOWN_OPTION               "%1!s! is not an option apprecorder has. Run apprecorder help to see the ones it does."
#define APR_EN_ERR_OPTION_NEEDS_VALUE           "%1!s! needs a value written after it."
#define APR_EN_ERR_BAD_NUMBER                   "%1!s! needs a number, and it was given %2!s!."
#define APR_EN_ERR_OUT_OF_RANGE                 "%1!s! accepts %2!s! up to %3!s!, and it was given %4!s!."
#define APR_EN_ERR_GAIN_WITHOUT_SOURCE          "--gain sets the gain of the source written before it, so a source has to come first."
#define APR_EN_ERR_BUS_HAS_NO_SOURCE            "The bus %1!s! has nothing to record. Give it a source with --pid, --exe, --device or --fake."
#define APR_EN_ERR_BUS_HAS_NO_OUTPUT            "The bus %1!s! has nowhere to go. Give it a file with --out."
#define APR_EN_ERR_PID_NOT_RUNNING              "No process on this computer has the id %1!s!."
#define APR_EN_ERR_EXE_NOT_PLAYING              "Nothing called %1!s! is playing audio right now. Run apprecorder list-apps to see what is."
#define APR_EN_ERR_EXE_AMBIGUOUS                "Several things called %1!s! are playing audio at once: %2!s!. Name the one you want with --pid."
#define APR_EN_ERR_DEVICE_NOT_FOUND             "This computer has no capture device called %1!s!. Run apprecorder list-devices to see the ones it has."
#define APR_EN_ERR_DEVICE_AMBIGUOUS             "More than one capture device matches %1!s!: %2!s!. Write the whole name, or the device id."
#define APR_EN_ERR_NO_EXTENSION                 "%1!s! has no file extension, so apprecorder cannot tell what to write into it. Add one, or say --format."
#define APR_EN_ERR_OUTPUT_NOT_WRITABLE          "%1!s! cannot be written: %2!s!"
#define APR_EN_ERR_TOO_MANY_BUSES               "This build records %1!s! buses at once and the command line asks for more."
#define APR_EN_ERR_TOO_MANY_SOURCES             "The bus %1!s! takes %2!s! sources and the command line gives it more."
#define APR_EN_ERR_TOO_MANY_OUTPUTS             "The bus %1!s! takes %2!s! outputs and the command line gives it more."
#define APR_EN_ERR_CAPTURE_START                "%1!s! could not be captured: %2!s!"
#define APR_EN_ERR_DUPLICATE_OUTPUT             "%1!s! is named as an output twice, and two recordings cannot share one file."
#define APR_EN_ERR_OPTION_NOT_FOR_COMMAND       "%1!s! means nothing to the command %2!s!."
#define APR_EN_WARN_SYSTEM_CAPTURE_SCOPE        "--system-minus-tree records every sound this computer plays, from every application, and writes all of it into your file."
#define APR_EN_WARN_SYSTEM_CAPTURE_TREE         "Held back from the recording: %1!s!, every program it has started, every program those started, and any program it starts later."
#define APR_EN_WARN_SYSTEM_CAPTURE_MEMBERS      "In that tree at this moment: %1!s!."
#define APR_EN_WARN_SYSTEM_CAPTURE_LAUNCHER     "If %1!s! is a terminal, a shell or a launcher, then everything you have run from it is held back too, including programs you would not think of as belonging to it."
#define APR_EN_WARN_STILL_FINISHING             "Still finishing. apprecorder does not abandon a recording part-written, so the files are being closed now."
#define APR_EN_WARN_ACTION_FAILED               "%1!s! stopped taking audio: %2!s! It is still being closed, and what it holds still plays."
#define APR_EN_STATUS_DRY_RUN_HEADER            "Dry run. This is what apprecorder would do, and it is doing none of it."
#define APR_EN_STATUS_DRY_RUN_OK                "The command line describes a recording apprecorder can make. No audio device was opened and no file was written."
#define APR_EN_STATUS_PLAN_SESSION              "Session format: %1!s! Hz, %2!s! channels."
#define APR_EN_STATUS_PLAN_BUS                  "Bus %1!s!"
#define APR_EN_STATUS_PLAN_SOURCE               "source: %1!s! (%2!s!), gain %3!s! dB"
#define APR_EN_STATUS_PLAN_OUTPUT               "output: %1!s! as %2!s!"
#define APR_EN_STATUS_WROTE                     "Wrote %1!s!, %2!s! seconds."
#define APR_EN_STATUS_ELAPSED                   "Recorded %1!s! seconds."
#define APR_EN_LIST_APPS_HEADER                 "Applications playing audio right now."
#define APR_EN_LIST_APPS_EMPTY                  "Nothing is playing audio on this computer right now."
#define APR_EN_LIST_APPS_ROW                    "%1!s!  %2!s!"
#define APR_EN_LIST_APPS_ROW_MUTED              "%1!s!  %2!s!  - muted in the Windows volume mixer, so it would record as silence"
#define APR_EN_LIST_APPS_ROW_IDLE               "%1!s!  %2!s!  - holds an audio session but is silent at this moment"
#define APR_EN_LIST_DEVICES_HEADER              "Audio capture devices on this computer."
#define APR_EN_LIST_DEVICES_EMPTY               "This computer has no audio capture device switched on."
#define APR_EN_LIST_DEVICES_ROW                 "%1!s!"
#define APR_EN_LIST_DEVICES_ROW_DEFAULT         "%1!s!  - the one Windows records from by default"
#define APR_EN_LIST_DEVICES_ID_LINE             "device id: %1!s!"
#define APR_EN_SOURCE_KIND_PROCESS              "application"
#define APR_EN_SOURCE_KIND_SYSTEM_MINUS_TREE    "all system audio minus one process tree"
#define APR_EN_SOURCE_KIND_DEVICE               "capture device"
#define APR_EN_SOURCE_KIND_FAKE                 "generated by apprecorder"
/* The bus a recording gets when the command line never says --bus. It is a
 * name a person sees, so it is here rather than a literal in cli.c. */
#define APR_EN_CLI_DEFAULT_BUS_NAME             "Recording"

/* Plurals. %1 is always the count. English reaches only ONE and OTHER; the
 * other four slots carry the OTHER text so that no slot is ever empty and so
 * that a wrong category selection degrades into correct English rather than
 * into a blank label. */
#define APR_EN_N_SOURCES_ZERO            "%1!s! sources"
#define APR_EN_N_SOURCES_ONE             "%1!s! source"
#define APR_EN_N_SOURCES_TWO             "%1!s! sources"
#define APR_EN_N_SOURCES_FEW             "%1!s! sources"
#define APR_EN_N_SOURCES_MANY            "%1!s! sources"
#define APR_EN_N_SOURCES_OTHER           "%1!s! sources"

#define APR_EN_N_BUSES_ZERO              "%1!s! buses"
#define APR_EN_N_BUSES_ONE               "%1!s! bus"
#define APR_EN_N_BUSES_TWO               "%1!s! buses"
#define APR_EN_N_BUSES_FEW               "%1!s! buses"
#define APR_EN_N_BUSES_MANY              "%1!s! buses"
#define APR_EN_N_BUSES_OTHER             "%1!s! buses"

#define APR_EN_N_FRAMES_LOST_ZERO        "%1!s! frames lost"
#define APR_EN_N_FRAMES_LOST_ONE         "%1!s! frame lost"
#define APR_EN_N_FRAMES_LOST_TWO         "%1!s! frames lost"
#define APR_EN_N_FRAMES_LOST_FEW         "%1!s! frames lost"
#define APR_EN_N_FRAMES_LOST_MANY        "%1!s! frames lost"
#define APR_EN_N_FRAMES_LOST_OTHER       "%1!s! frames lost"

/* ---------------------------------------------------------------------------
 * UI shell (src/ui). Rules that bind a translator here specifically:
 *
 *   - THE AMPERSAND IS THE KEYBOARD PATH, not decoration. Every menu string
 *     keeps exactly one "&", on a letter that is unique inside its own menu.
 *     Dropping it removes the only way a keyboard user reaches that item, and
 *     AGENTS.md rule 5 makes that a correctness failure, not a cosmetic one.
 *   - The text after "\t" is the accelerator as Windows renders it. It stays
 *     in the same catalog entry so label and shortcut cannot drift apart, and
 *     it is deliberately NOT localized letter-by-letter -- the key the user
 *     actually presses does not change with the interface language.
 *   - PANE and DESC entries are read aloud by a screen reader and never drawn.
 *     They are the accessible name and description of a pane, so they must
 *     read as speech, not as a caption.
 * ------------------------------------------------------------------------- */

#define APR_EN_UI_TITLE_UNTITLED         "Untitled session - apprecorder"
#define APR_EN_UI_TITLE_SESSION          "%1!s! - apprecorder"

#define APR_EN_UI_PANE_CANVAS            "Signal flow"
#define APR_EN_UI_PANE_TREE              "Structure"
#define APR_EN_UI_PANE_STATUS            "Status"
#define APR_EN_UI_DESC_CANVAS            "The recording graph, drawn as nodes. Press Tab to move between nodes, and F6 to leave this pane."
#define APR_EN_UI_DESC_TREE              "The same recording graph as a tree: every bus, the sources feeding it, and the files it writes."
#define APR_EN_UI_STATUS_READY           "Ready."
#define APR_EN_UI_PANE_SPLITTER          "Panel divider"
#define APR_EN_UI_DESC_SPLITTER          "Sets how much room the structure panel takes. Press the left and right arrow keys to move it, or Home and End for its narrowest and widest."

#define APR_EN_UI_MENU_FILE              "&File"
#define APR_EN_UI_MENU_FILE_NEW          "&New Session\tCtrl+N"
#define APR_EN_UI_MENU_FILE_OPEN         "&Open Session...\tCtrl+O"
#define APR_EN_UI_MENU_FILE_SAVE         "&Save Session\tCtrl+S"
#define APR_EN_UI_MENU_FILE_SAVE_AS      "Save Session &As...\tCtrl+Shift+S"
#define APR_EN_UI_MENU_FILE_EXIT         "E&xit\tAlt+F4"

#define APR_EN_UI_MENU_EDIT              "&Edit"
#define APR_EN_UI_MENU_ADD_SOURCE        "Add &Source...\tCtrl+1"
#define APR_EN_UI_MENU_ADD_BUS           "Add &Bus...\tCtrl+2"
#define APR_EN_UI_MENU_ADD_ACTION        "Add &Output...\tCtrl+3"
#define APR_EN_UI_MENU_CONNECT           "&Connect...\tCtrl+E"
#define APR_EN_UI_MENU_REMOVE            "&Remove\tDelete"

#define APR_EN_UI_MENU_RECORDING         "&Recording"
#define APR_EN_UI_MENU_RECORD_START      "&Start Recording\tCtrl+R"
#define APR_EN_UI_MENU_RECORD_STOP       "S&top Recording\tCtrl+."

#define APR_EN_UI_MENU_VIEW              "&View"
#define APR_EN_UI_MENU_VIEW_TREE         "&Structure Panel\tCtrl+T"
#define APR_EN_UI_MENU_VIEW_DARK         "&Dark Appearance\tCtrl+D"
#define APR_EN_UI_MENU_VIEW_NEXT_PANE    "&Next Pane\tF6"

#define APR_EN_UI_MENU_HELP              "&Help"
#define APR_EN_UI_MENU_HELP_KEYS         "&Keyboard Shortcuts\tF1"
#define APR_EN_UI_MENU_HELP_ABOUT        "&About apprecorder"

/* ---------------------------------------------------------------------------
 * The canvas (src/ui/canvas.c, src/ui/node_window.c).
 *
 * WHAT A TRANSLATOR HAS TO KNOW HERE, BECAUSE IT IS NOT OBVIOUS FROM THE TEXT:
 *
 *   - NONE OF THESE ARE DRAWN. Every one of them is spoken -- they are the
 *     accessible name and description of a node window, and the sentences a
 *     screen reader says when the graph changes. Write them as speech.
 *   - The UI_NODE_* entries carry BOTH the node's own name and its kind,
 *     because kind is otherwise carried only by colour, and colour is never
 *     allowed to be the only carrier of a fact.
 *   - The UI_NODE_DESC_* entries carry the node's EDGES. An edge is painted on
 *     the canvas and has no element of its own to land on, so if the edge is
 *     not in this sentence it does not exist for a screen reader user.
 *   - The key names ("Control and Down Arrow") are spelled out rather than
 *     abbreviated because they are read aloud, and they name the key that is
 *     actually pressed -- which does not change with the interface language.
 *   - UI_LIST_PAIR and UI_LIST_MORE are the ONLY sanctioned way to join user
 *     data (bus names, file names) into a list in this product. Fold PAIR over
 *     the last two and MORE over the rest. They are catalog entries so that the
 *     separator and the conjunction are yours, not a comma frozen into C.
 * ------------------------------------------------------------------------- */

#define APR_EN_UI_NODE_SOURCE                   "%1!s!, source"
#define APR_EN_UI_NODE_SOURCE_GAIN              "%1!s!, source, %2!s! decibels"
#define APR_EN_UI_NODE_BUS                      "%1!s!, bus"
#define APR_EN_UI_NODE_ACTION                   "%1!s!, output"
#define APR_EN_UI_NODE_LABEL_SOURCE             "Source"
#define APR_EN_UI_NODE_LABEL_BUS                "Bus"
#define APR_EN_UI_NODE_LABEL_ACTION             "Output"
#define APR_EN_UI_NODE_LABEL_SOURCE_GAIN        "Source, %1!s! decibels"
#define APR_EN_UI_NODE_DESC_SOURCE_FEEDING      "Feeds %1!s!. Press Control and Down Arrow to move to what it feeds, or Control and E to feed another bus."
#define APR_EN_UI_NODE_DESC_SOURCE_ALONE        "This source feeds nothing yet. Press Control and E, move to a bus, then press Control and E again."
#define APR_EN_UI_NODE_DESC_BUS_FULL            "Mixes %1!s! and writes %2!s!. Press Control and Up Arrow to move to a source feeding it, or Control and Down Arrow to move to a file it writes."
#define APR_EN_UI_NODE_DESC_BUS_NO_SOURCES      "Writes %1!s!, but nothing feeds this bus yet. Move to a source, press Control and E, come back here and press Control and E again."
#define APR_EN_UI_NODE_DESC_BUS_NO_OUTPUTS      "Mixes %1!s!, but this bus writes no file yet. Press Control and 3 to add one."
#define APR_EN_UI_NODE_DESC_BUS_EMPTY           "Nothing feeds this bus and it writes no file yet."
#define APR_EN_UI_NODE_DESC_ACTION              "Written from %1!s!. Press Control and Up Arrow to move to that bus."
#define APR_EN_UI_LIST_PAIR                     "%1!s! and %2!s!"
#define APR_EN_UI_LIST_MORE                     "%1!s!, %2!s!"
#define APR_EN_UI_ANN_CONNECT_START             "Connecting from %1!s!. Move to a bus and press Control and E again, or press Escape to cancel."
#define APR_EN_UI_ANN_CONNECT_DONE              "%1!s! now feeds %2!s!."
#define APR_EN_UI_ANN_CONNECT_ALREADY           "%1!s! already feeds %2!s!."
#define APR_EN_UI_ANN_CONNECT_REFUSED           "A source can only be connected to a bus, and %1!s! is not a bus."
#define APR_EN_UI_ANN_DISCONNECT_START          "Disconnecting %1!s!. Move to the bus it should stop feeding and press Control and Shift and E again, or press Escape to cancel."
#define APR_EN_UI_ANN_DISCONNECT_DONE           "%1!s! no longer feeds %2!s!."
#define APR_EN_UI_ANN_DISCONNECT_NONE           "%1!s! was not feeding %2!s!."
#define APR_EN_UI_ANN_CANCELLED                 "Cancelled."
#define APR_EN_UI_ANN_REMOVED                   "%1!s! removed."
#define APR_EN_UI_ANN_REMOVE_REFUSED            "A file is removed together with the bus that writes it, not on its own."
#define APR_EN_UI_ANN_GAIN                      "%1!s!, %2!s! decibels."
#define APR_EN_UI_ANN_GAIN_NO_EDGE              "%1!s! feeds no bus yet, so there is no level to set."
#define APR_EN_UI_ANN_NO_EDGE_DOWN              "%1!s! feeds nothing yet."
#define APR_EN_UI_ANN_NO_EDGE_UP                "Nothing feeds %1!s! yet."
#define APR_EN_UI_ANN_CANVAS_EMPTY              "The signal flow is empty. Press Control and 1 to add a source."
#define APR_EN_UI_ANN_NOT_YET                   "That is not available yet."
#define APR_EN_UI_ANN_CONNECT_NOT_SOURCE        "A connection starts at a source, and %1!s! is not one."
#define APR_EN_UI_ANN_GAIN_NOT_SOURCE           "Only a source has a level, and %1!s! is not one."

/* One line per canvas operation, for Help > Keyboard Shortcuts. The binding
 * table in include/ui_canvas.h is both what dispatches the key and what that
 * screen renders, so a shortcut cannot be documented as one key and
 * implemented as another. */

#define APR_EN_UI_KEY_NEXT_NODE                 "Move to the next node"
#define APR_EN_UI_KEY_PREV_NODE                 "Move to the previous node"
#define APR_EN_UI_KEY_NEXT_IN_COLUMN            "Move to the next node in this column"
#define APR_EN_UI_KEY_PREV_IN_COLUMN            "Move to the previous node in this column"
#define APR_EN_UI_KEY_DOWNSTREAM                "Go to what this node feeds"
#define APR_EN_UI_KEY_UPSTREAM                  "Go to what feeds this node"
#define APR_EN_UI_KEY_FIRST                     "Move to the first node"
#define APR_EN_UI_KEY_LAST                      "Move to the last node"
#define APR_EN_UI_KEY_CONNECT                   "Connect this node to another"
#define APR_EN_UI_KEY_DISCONNECT                "Disconnect this node from another"
#define APR_EN_UI_KEY_REMOVE                    "Remove this node"
#define APR_EN_UI_KEY_ADD_SOURCE                "Add a source"
#define APR_EN_UI_KEY_ADD_BUS                   "Add a bus"
#define APR_EN_UI_KEY_ADD_ACTION                "Add an output"
#define APR_EN_UI_KEY_GAIN_UP                   "Make this source louder"
#define APR_EN_UI_KEY_GAIN_DOWN                 "Make this source quieter"
#define APR_EN_UI_KEY_CANCEL                    "Cancel what is half done"
#define APR_EN_UI_KEY_DESCRIBE                  "Say this node and its connections again"

/* ---- the structure panel (src/ui/tree_panel.c).
 *
 * A TREEVIEW ITEM'S TEXT IS ITS ACCESSIBLE NAME. There is no second string a
 * screen reader reads instead, so each row below is a whole sentence: what
 * the node is, what kind it is, what it is wired to, and any state that
 * changes what the file will actually contain. "Teams" is a label; "Teams,
 * application, muted in Windows so it records silence, feeding Main Mix" is
 * the row that saves a three-hour recording.
 *
 * The bus row counts arrive as already-pluralised phrases (N_SOURCES,
 * N_OUTPUTS) in their own inserts, so a translator controls agreement; the
 * state clauses arrive the same way, in one insert each, so a translator can
 * move a state clause to wherever Arabic wants it rather than finding it
 * welded to the end by C. */

#define APR_EN_UI_TREE_NAME                     "Recording graph"
#define APR_EN_UI_TREE_DESC                     "Every bus in this session, the sources feeding it and the files it writes. Up Arrow and Down Arrow move through the graph, Left Arrow and Right Arrow collapse and expand a bus, and typing the first letters of a name jumps to it."
#define APR_EN_UI_TREE_EMPTY                    "This session has no buses yet. Use Add Bus on the Edit menu to make one."
#define APR_EN_UI_TREE_UNASSIGNED_GROUP         "Sources not connected to any bus"
#define APR_EN_UI_TREE_BUS                      "%1!s!, bus, mixing %2!s! to %3!s!"
#define APR_EN_UI_TREE_BUS_RECORDING            "%1!s!, bus, recording now, mixing %2!s! to %3!s!"
#define APR_EN_UI_TREE_SOURCE                   "%1!s!, %2!s!, feeding %3!s!"
#define APR_EN_UI_TREE_SOURCE_SHARED            "%1!s!, %2!s!, feeding %3!s! and %4!s!"
#define APR_EN_UI_TREE_SOURCE_STATE             "%1!s!, %2!s!, %3!s!, feeding %4!s!"
#define APR_EN_UI_TREE_SOURCE_STATE_SHARED      "%1!s!, %2!s!, %3!s!, feeding %4!s! and %5!s!"
#define APR_EN_UI_TREE_SOURCE_UNUSED            "%1!s!, %2!s!, connected to no bus, so nothing records it"
#define APR_EN_UI_TREE_SOURCE_UNUSED_STATE      "%1!s!, %2!s!, %3!s!, and connected to no bus, so nothing records it"
#define APR_EN_UI_TREE_STATE_MUTED              "muted in Windows, so it records silence"
#define APR_EN_UI_TREE_STATE_EXITED             "closed, so it records silence from here on"
#define APR_EN_UI_TREE_ACTION                   "%1!s!, written from %2!s!"
#define APR_EN_UI_TREE_ACTION_FAILED            "%1!s!, written from %2!s!, stopped after an error"

/* ---- session files (src/session/, and the --session option).
 *
 * WHY THE RESOLUTION MESSAGES CARRY TWO NAMES EACH. A session file records
 * what to capture; process ids do not survive a reboot, so opening one is a
 * search rather than a lookup, and it can succeed in ways that are not what
 * the file asked for. "Teams was not found" leaves the reader nothing to do.
 * Naming both what was recorded and what is there now lets them decide
 * whether the substitution is the same program -- so every entry below that
 * describes a substitution has an insert for each half.
 *
 * The system-capture entry is deliberately NOT the same sentence as
 * WARN_SYSTEM_CAPTURE_SCOPE. That one describes a capture the user just
 * asked for by typing --system-minus-tree. This one describes a capture a
 * FILE asked for, which design 4.1.1 says must never proceed without
 * confirmation, and it has to say what to do about it. */

#define APR_EN_CLI_CMD_SAVE_SESSION             "save-session          Write the recording described on this command line to a session file instead of recording it."
#define APR_EN_CLI_OPT_SESSION                  "--session <path>       The session file: read by record, written by save-session."
#define APR_EN_CLI_OPT_ALLOW_SYSTEM_CAPTURE     "--allow-system-capture Agree to record everything the computer is playing, when a session file asks for it. Never implied."
#define APR_EN_CLI_OPT_ALLOW_MISSING            "--allow-missing        Record without the sources that could not be found, instead of stopping."

#define APR_EN_ERR_SESSION_NOT_FOUND            "There is no session file at %1!s!."
#define APR_EN_ERR_SESSION_UNREADABLE           "%1!s! could not be read: %2!s!"
/* The backslash sentence is not padding. A hand-edited session file on
 * Windows fails here far more often than for any other reason: JSON treats a
 * backslash as an escape, so C:\Users\me is invalid and C:\\Users\\me is what
 * is meant. Files apprecorder writes are always correct; this message is for
 * the ones a person edited. */
#define APR_EN_ERR_SESSION_NOT_JSON             "%1!s! is not a session file: the text is not JSON. If you edited it by hand, check that every backslash in a Windows path is doubled, or use forward slashes instead."
#define APR_EN_ERR_SESSION_TRUNCATED            "%1!s! stops part way through. It was probably not finished being written."
#define APR_EN_ERR_SESSION_NOT_A_SESSION        "%1!s! is JSON, but it is not an apprecorder session."
#define APR_EN_ERR_SESSION_TOO_NEW              "%1!s! was written by a newer version of apprecorder and needs at least version %2!s! of the session format to be read safely. This build reads version %3!s!."
#define APR_EN_ERR_SESSION_TOO_OLD              "%1!s! uses session format version %2!s!, which this build no longer reads."
#define APR_EN_ERR_SESSION_BAD_FIELD            "%1!s! cannot be used: %2!s! is not the kind of value that belongs there."
#define APR_EN_ERR_SESSION_BAD_VALUE            "%1!s! cannot be used: %2!s! is outside the range apprecorder can work with."
#define APR_EN_ERR_SESSION_TOO_MANY             "%1!s! describes more than apprecorder can hold, at %2!s!."
#define APR_EN_ERR_SESSION_DANGLING_REF         "%1!s! cannot be used: %2!s! names a source the file does not describe."
#define APR_EN_ERR_SESSION_WITH_SOURCES         "--session describes the whole recording, so %1!s! cannot be given as well. Edit the session file, or leave --session out."
#define APR_EN_ERR_SESSION_NEEDED               "save-session needs --session <path> to say where to write."
#define APR_EN_ERR_SESSION_NOT_WRITTEN          "%1!s! could not be written: %2!s!"

#define APR_EN_WARN_SESSION_FROM_NEWER          "%1!s! was written by a newer version of apprecorder. Anything it asks for that this build does not know about is being ignored."
#define APR_EN_WARN_SESSION_UNKNOWN_KEYS        "%1!s! contains settings this build does not know, starting with %2!s!. They are being ignored."

#define APR_EN_ERR_SESSION_SOURCE_MISSING       "%1!s! is not running. The session recorded it at %2!s!."
#define APR_EN_ERR_SESSION_DEVICE_MISSING       "%1!s! is not connected, so it cannot be recorded."
#define APR_EN_ERR_SESSION_AMBIGUOUS            "There is more than one %1!s! and nothing in the session says which one to record."
#define APR_EN_ERR_SESSION_AMBIGUOUS_PIDS       "Choose one with --pid: %1!s!"
/* Design 4.1.1: this must say what is really being captured -- a whole
 * process tree is held back, and everything else on the machine is recorded
 * -- and it must say what the user has to do to agree to that. */
#define APR_EN_ERR_SESSION_NEEDS_CONSENT        "%1!s! asks to record everything this computer plays, holding back only %2!s! and whatever it has started. apprecorder will not do that because a file asked for it. Add --allow-system-capture if that is what you want."

#define APR_EN_WARN_SESSION_MOVED               "%1!s! is now running from %2!s!, not %3!s! where the session recorded it. Recording the copy that is running."
#define APR_EN_WARN_SESSION_BY_WINDOW_CLASS     "There is more than one %1!s!. Recording process %2!s!, because its window matches the one the session recorded."
#define APR_EN_WARN_SESSION_FIRST_OF_MANY       "There is more than one %1!s! and nothing tells them apart. Recording process %2!s!."
#define APR_EN_WARN_SESSION_DEVICE_BY_NAME      "%1!s! is connected but Windows now identifies it differently. Recording it anyway."
#define APR_EN_WARN_SESSION_DROPPED             "Recording without %1!s!, which could not be found."

#define APR_EN_STATUS_SESSION_LOADED            "Loaded %1!s!."
#define APR_EN_STATUS_SESSION_SAVED             "Saved %1!s!."

#define APR_EN_N_OTHER_BUSES_ZERO               "%1!s! other buses"
#define APR_EN_N_OTHER_BUSES_ONE                "%1!s! other bus"
#define APR_EN_N_OTHER_BUSES_TWO                "%1!s! other buses"
#define APR_EN_N_OTHER_BUSES_FEW                "%1!s! other buses"
#define APR_EN_N_OTHER_BUSES_MANY               "%1!s! other buses"
#define APR_EN_N_OTHER_BUSES_OTHER              "%1!s! other buses"

#define APR_EN_N_OUTPUTS_ZERO                   "%1!s! outputs"
#define APR_EN_N_OUTPUTS_ONE                    "%1!s! output"
#define APR_EN_N_OUTPUTS_TWO                    "%1!s! outputs"
#define APR_EN_N_OUTPUTS_FEW                    "%1!s! outputs"
#define APR_EN_N_OUTPUTS_MANY                   "%1!s! outputs"
#define APR_EN_N_OUTPUTS_OTHER                  "%1!s! outputs"


